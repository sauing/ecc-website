# Copy to .env.local. These are placeholders, not real credentials.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
AUTH_GOOGLE_ENABLED=false
# Password/Google sign-in use only the publishable key. PIN session issuance additionally needs a server-only secret key.

# Optional trusted-browser ECC PIN. Server-only values: never prefix these NEXT_PUBLIC_.
AUTH_PIN_ENABLED=false
SUPABASE_SECRET_KEY=
AUTH_PIN_SECRET=
